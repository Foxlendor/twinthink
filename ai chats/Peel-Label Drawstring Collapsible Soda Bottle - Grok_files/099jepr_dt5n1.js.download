(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,1648786,e=>{"use strict";var t=e.i(25464),a=e.i(2460512);e.i(379120);var r=e.i(2082306),o=e.i(8477096),i=e.i(7470586),l=e.i(9636638),s=e.i(4283094),n=e.i(1102026),d=e.i(8635963),p=e.i(4801906),m=e.i(4508272),u=e.i(631221);e.i(1354374);var c=e.i(352006);function h(e){return e.map(e=>({value:e,key:Math.random()})).sort((e,t)=>e.key-t.key).map(({value:e})=>e)}function b(e){return Array.from({length:e.reduce((e,t)=>Math.max(e,t.examples.length),0)}).flatMap((t,a)=>e.flatMap(e=>{let t=e.examples[a];return void 0===t?[]:[{example:t,category:e}]}))}e.s(["CHIPS_PER_PAGE",0,6,"buildExampleOrder",0,function(e){return b(e)},"buildShuffledExampleOrder",0,function(e){return b(h(e).map(e=>({...e,examples:h(e.examples)})))},"shuffled",0,h,"useBuildCategories",0,function(){var e;let h,b=(0,a.c)(2),{t:g}=(0,c.useTranslation)("chat");return b[0]!==g?(e=g,h=[{id:"game",icon:(0,t.jsx)(l.GameControllerIcon,{size:14}),iconClassName:"text-green-500 dark:text-green-400",iconHoverClassName:"text-fg-tertiary group-hover/chip:text-green-500 dark:group-hover/chip:text-green-400",hoverBorderClassName:"hover:border-green-500/25 dark:hover:border-border-l1",hoverShadowClassName:"dark:hover:shadow-[0_4px_24px_-8px_rgba(74,222,128,0.2)]",examples:[{id:"endless-runner",label:e("build-mode-starters.example.game.endless-runner.label","Endless runner"),prompt:e("build-mode-starters.example.game.endless-runner.prompt","Build a browser endless runner where the player jumps and slides past procedural obstacles that get denser over time. Include one-tap or spacebar jump, combo scoring, speed ramps, and a high-score that persists in local storage. Add a game-over screen with restart and smooth animations for jump, land, and obstacle collisions.")},{id:"3d-maze",label:e("build-mode-starters.example.game.3d-maze.label","3D maze"),prompt:e("build-mode-starters.example.game.3d-maze.prompt","Create a first-person low-poly 3D maze with WASD movement, mouse look, and collectibles scattered through the corridors. Include a minimap that reveals explored paths, a timer, and a win screen when the exit is found. Make collision with walls feel solid and keep the aesthetic clean and playful.")},{id:"space-shooter",label:e("build-mode-starters.example.game.space-shooter.label","Space shooter"),prompt:e("build-mode-starters.example.game.space-shooter.prompt","Make a top-down space shooter with enemy waves, player shooting, and power-ups for multi-shot, shield, and speed. Include lives, score tracking, a high-score board, and a pause menu. Add parallax starfield background, muzzle flashes, and smooth ship movement with keyboard or pointer controls.")},{id:"tower-defense",label:e("build-mode-starters.example.game.tower-defense.label","Tower defense"),prompt:e("build-mode-starters.example.game.tower-defense.prompt","Build a tower-defense game with a path for creeps, placeable towers, and gold earned from kills. Include multiple tower types with different ranges and costs, wave progression, and an upgrade path for damage and fire rate. Show lives remaining, current gold, and a game-over or victory screen with restart.")},{id:"platformer",label:e("build-mode-starters.example.game.platformer.label","Platformer"),prompt:e("build-mode-starters.example.game.platformer.prompt","Create a 2D platformer with run, jump, double-jump, moving platforms, coins, and hazards. Include a checkpoint system, a coin counter, and a goal flag that ends the level. Make controls responsive with arrow keys or WASD, and add a simple level select or restart on death.")}]},{id:"website",icon:(0,t.jsx)(s.GlobeIcon,{size:14}),iconClassName:"text-cyan-500 dark:text-cyan-400",iconHoverClassName:"text-fg-tertiary group-hover/chip:text-cyan-500 dark:group-hover/chip:text-cyan-400",hoverBorderClassName:"hover:border-cyan-500/25 dark:hover:border-border-l1",hoverShadowClassName:"dark:hover:shadow-[0_4px_24px_-8px_rgba(34,211,238,0.2)]",examples:[{id:"bio-page",label:e("build-mode-starters.example.website.bio-page.label","Bio page"),prompt:e("build-mode-starters.example.website.bio-page.prompt","Create a link-in-bio page with a circular avatar, display name, short bio, and a vertical stack of featured link buttons. Include social icons, subtle hover animations, and a theme toggle between light and dark. Make it mobile-first with a polished, modern layout that works well as a personal landing link.")},{id:"landing-page",label:e("build-mode-starters.example.website.landing-page.label","Landing page"),prompt:e("build-mode-starters.example.website.landing-page.prompt","Build a SaaS product landing page with a bold hero, clear value proposition, feature grid, pricing tiers, testimonials, and an email signup form. Include sticky navigation, smooth scroll anchors, and a strong call-to-action throughout. Make it fully responsive with a clean, conversion-oriented design.")},{id:"portfolio",label:e("build-mode-starters.example.website.portfolio.label","Portfolio"),prompt:e("build-mode-starters.example.website.portfolio.prompt","Design a personal portfolio site with project cards, an about section, skills, and a contact form. Include hover states on projects that reveal short descriptions, filter chips by category, and a polished footer. Make it responsive with smooth scroll and a modern, editorial visual style.")},{id:"event-page",label:e("build-mode-starters.example.website.event-page.label","Event page"),prompt:e("build-mode-starters.example.website.event-page.prompt","Build a one-page event site with a countdown timer, schedule agenda, speaker cards, venue map placeholder, and an RSVP form. Include ticket tiers or capacity messaging, success feedback after RSVP, and sticky nav for each section. Make it responsive with a vibrant, event-branded aesthetic.")}]},{id:"data-viz",icon:(0,t.jsx)(r.BarChartIcon,{size:14}),iconClassName:"text-yellow-500 dark:text-yellow-400",iconHoverClassName:"text-fg-tertiary group-hover/chip:text-yellow-500 dark:group-hover/chip:text-yellow-400",hoverBorderClassName:"hover:border-yellow-500/25 dark:hover:border-border-l1",hoverShadowClassName:"dark:hover:shadow-[0_4px_24px_-8px_rgba(250,204,21,0.2)]",examples:[{id:"revenue-dashboard",label:e("build-mode-starters.example.data-viz.revenue-dashboard.label","Revenue dashboard"),prompt:e("build-mode-starters.example.data-viz.revenue-dashboard.prompt","Build an interactive revenue dashboard with date range filters, KPI cards for revenue, growth, and churn, and trend charts that update with the selection. Include a breakdown table, hover tooltips, and sample data so it works offline. Make the layout responsive with a clean analytics aesthetic.")},{id:"world-map",label:e("build-mode-starters.example.data-viz.world-map.label","World map"),prompt:e("build-mode-starters.example.data-viz.world-map.prompt","Create a choropleth world map that colors countries by a metric, with a legend, hover tooltips, and a metric switcher. Include sample data, pan and zoom, and a side panel that shows details for the selected country. Make interactions smooth and the visual hierarchy clear.")},{id:"network-graph",label:e("build-mode-starters.example.data-viz.network-graph.label","Network graph"),prompt:e("build-mode-starters.example.data-viz.network-graph.prompt","Build a force-directed network graph with draggable nodes, zoom and pan, edge labels, and a search box that highlights matching nodes. Include sample graph data, click-to-inspect node details, and controls to reheat or freeze the simulation. Make the canvas full-bleed and performance-friendly.")},{id:"poll-app",label:e("build-mode-starters.example.data-viz.poll-app.label","Poll app"),prompt:e("build-mode-starters.example.data-viz.poll-app.prompt","Build a live poll app where users can create a question with multiple options, vote once, and see animated result bars update in real time with local state. Include a total-votes counter, percentage labels, and the ability to reset or start a new poll. Make it responsive with clear selected and disabled states.")}]},{id:"three-d",icon:(0,t.jsx)(i.CubeIcon,{size:14}),iconClassName:"text-lime-500 dark:text-lime-400",iconHoverClassName:"text-fg-tertiary group-hover/chip:text-lime-500 dark:group-hover/chip:text-lime-400",hoverBorderClassName:"hover:border-lime-500/25 dark:hover:border-border-l1",hoverShadowClassName:"dark:hover:shadow-[0_4px_24px_-8px_rgba(132,204,22,0.2)]",examples:[{id:"3d-globe",label:e("build-mode-starters.example.three-d.3d-globe.label","3D globe"),prompt:e("build-mode-starters.example.three-d.3d-globe.prompt","Build a rotating 3D globe with glowing location markers, drag-to-spin, and click-to-focus on a marker. Include a list of featured locations, soft ambient lighting, and auto-rotate that pauses while the user interacts. Make the scene full-viewport with a subtle atmosphere and smooth camera transitions.")},{id:"solar-system",label:e("build-mode-starters.example.three-d.solar-system.label","Solar system"),prompt:e("build-mode-starters.example.three-d.solar-system.prompt","Create a 3D solar system with orbiting planets, adjustable simulation speed, labels, and click-to-focus camera moves. Include a pause control, orbital trails, and simple info panels for each planet. Keep the aesthetic dark and spacey with smooth animation loops.")},{id:"product-viewer",label:e("build-mode-starters.example.three-d.product-viewer.label","Product viewer"),prompt:e("build-mode-starters.example.three-d.product-viewer.prompt","Build a 3D product viewer that orbits a stylized product model with lighting controls, auto-rotate, and material or color variants. Include zoom, a reset camera button, and a clean commerce-style UI chrome around the canvas. Make interactions feel premium and responsive on desktop and mobile.")},{id:"starfield",label:e("build-mode-starters.example.three-d.starfield.label","Starfield"),prompt:e("build-mode-starters.example.three-d.starfield.prompt","Create a warp-speed 3D starfield you can steer with the mouse or pointer, with adjustable speed and density. Include a boost mode, subtle motion blur or streaking stars, and on-screen controls that do not clutter the view. Make it immersive and buttery smooth at 60fps.")},{id:"terrain-flyover",label:e("build-mode-starters.example.three-d.terrain-flyover.label","Terrain flyover"),prompt:e("build-mode-starters.example.three-d.terrain-flyover.prompt","Build a low-poly 3D terrain you can fly over with mouse-look and keyboard thrust, plus a wireframe toggle and height-based coloring. Include simple collision with the ground, a mini HUD for altitude and speed, and day/night lighting options. Keep the art style stylized and readable.")}]},{id:"generative",icon:(0,t.jsx)(m.SwirlIcon,{size:14}),iconClassName:"text-pink-500 dark:text-pink-400",iconHoverClassName:"text-fg-tertiary group-hover/chip:text-pink-500 dark:group-hover/chip:text-pink-400",hoverBorderClassName:"hover:border-pink-500/25 dark:hover:border-border-l1",hoverShadowClassName:"dark:hover:shadow-[0_4px_24px_-8px_rgba(236,72,153,0.2)]",examples:[{id:"particle-field",label:e("build-mode-starters.example.generative.particle-field.label","Particle field"),prompt:e("build-mode-starters.example.generative.particle-field.prompt","Build an interactive particle field that swirls toward the cursor with trails, color shifts, and adjustable particle count and force. Include a clear/reset control, background color options, and a download screenshot button. Make pointer interactions feel immediate and visually rich.")},{id:"fractal-tree",label:e("build-mode-starters.example.generative.fractal-tree.label","Fractal tree"),prompt:e("build-mode-starters.example.generative.fractal-tree.prompt","Create a generative fractal tree that grows with adjustable branching angle, depth, and length, plus a gentle wind sway. Include a regenerate button, color palette controls, and optional leaf or blossom overlays. Animate growth on load so the tree feels alive.")},{id:"mandelbrot-zoom",label:e("build-mode-starters.example.generative.mandelbrot-zoom.label","Mandelbrot zoom"),prompt:e("build-mode-starters.example.generative.mandelbrot-zoom.prompt","Build a Mandelbrot fractal explorer with click-to-zoom, drag to pan, smooth coloring, and iteration controls. Include preset interesting locations, a reset view button, and performance-conscious rendering. Make the UI minimal so the fractal stays the focus.")},{id:"kaleidoscope",label:e("build-mode-starters.example.generative.kaleidoscope.label","Kaleidoscope"),prompt:e("build-mode-starters.example.generative.kaleidoscope.prompt","Make a kaleidoscope that mirrors pointer movement into symmetric, colorful patterns with adjustable segment count and color modes. Include a freeze frame option, randomize, and export image. Keep animations fluid and the controls simple enough to play with immediately.")},{id:"flow-field",label:e("build-mode-starters.example.generative.flow-field.label","Flow field"),prompt:e("build-mode-starters.example.generative.flow-field.prompt","Create a flow-field art generator with drifting particles that follow a noise field, plus controls for speed, trail length, and palette. Include a randomize seed button, pause, and PNG export. Make the full canvas generative and satisfying to watch evolve.")}]},{id:"audio",icon:(0,t.jsx)(u.WaveformIcon,{size:14}),iconClassName:"text-purple-500 dark:text-purple-400",iconHoverClassName:"text-fg-tertiary group-hover/chip:text-purple-500 dark:group-hover/chip:text-purple-400",hoverBorderClassName:"hover:border-purple-500/25 dark:hover:border-border-l1",hoverShadowClassName:"dark:hover:shadow-[0_4px_24px_-8px_rgba(192,132,252,0.2)]",examples:[{id:"drum-machine",label:e("build-mode-starters.example.audio.drum-machine.label","Drum machine"),prompt:e("build-mode-starters.example.audio.drum-machine.prompt","Build a step-sequencer drum machine with a 16-step grid for kick, snare, hats, and percussion, plus tempo control and play/stop. Include pattern clear, randomize, swing, and visual step highlighting as it plays. Make the UI grid-based, responsive, and satisfying to click.")},{id:"synth-keyboard",label:e("build-mode-starters.example.audio.synth-keyboard.label","Synth keyboard"),prompt:e("build-mode-starters.example.audio.synth-keyboard.prompt","Create a playable synth keyboard with on-screen keys, computer keyboard mapping, waveform selection, and filter and envelope knobs. Include octave shift, volume, and a simple oscilloscope or level meter. Make pressed keys light up and audio start only after a user gesture.")},{id:"audio-visualizer",label:e("build-mode-starters.example.audio.audio-visualizer.label","Audio visualizer"),prompt:e("build-mode-starters.example.audio.audio-visualizer.prompt","Build a music visualizer that reacts to microphone input or an uploaded track with animated bars, circular modes, and color themes. Include play/pause for files, sensitivity control, and fullscreen. Make the visualization smooth and the controls unobtrusive.")},{id:"theremin",label:e("build-mode-starters.example.audio.theremin.label","Theremin"),prompt:e("build-mode-starters.example.audio.theremin.prompt","Build a mouse-controlled theremin with pitch mapped to X and volume to Y, plus waveform choice and reverb. Include a visual guide for the play area, mute toggle, and a simple pitch readout. Make the sound expressive and the interaction immediately understandable.")},{id:"chord-player",label:e("build-mode-starters.example.audio.chord-player.label","Chord player"),prompt:e("build-mode-starters.example.audio.chord-player.prompt","Build a chord-progression player with a scale or key picker, common progression presets, strum or arpeggio patterns, and looping playback. Include tempo control, highlighted active chord, and the ability to edit the progression sequence. Make it useful for songwriting practice with a clean music-app UI.")}]},{id:"simulation",icon:(0,t.jsx)(p.ScienceIcon,{size:14}),iconClassName:"text-orange-500 dark:text-orange-400",iconHoverClassName:"text-fg-tertiary group-hover/chip:text-orange-500 dark:group-hover/chip:text-orange-400",hoverBorderClassName:"hover:border-orange-500/25 dark:hover:border-border-l1",hoverShadowClassName:"dark:hover:shadow-[0_4px_24px_-8px_rgba(251,146,60,0.2)]",examples:[{id:"physics-sandbox",label:e("build-mode-starters.example.simulation.physics-sandbox.label","Physics sandbox"),prompt:e("build-mode-starters.example.simulation.physics-sandbox.prompt","Build a 3D physics playground where you can drop spheres, boxes, and cylinders that stack, bounce, and topple under gravity. Include tools to spawn shapes, clear the world, adjust gravity and restitution, and drag bodies around. Make interactions immediate with a simple toolbar and stable simulation.")},{id:"boids-flock",label:e("build-mode-starters.example.simulation.boids-flock.label","Boids flock"),prompt:e("build-mode-starters.example.simulation.boids-flock.prompt","Create a flocking simulation of boids that swarm with separation, alignment, and cohesion, and scatter or avoid the cursor. Include live sliders for each rule weight, population size, and speed. Make the canvas full-bleed with readable controls and smooth real-time motion.")},{id:"game-of-life",label:e("build-mode-starters.example.simulation.game-of-life.label","Game of Life"),prompt:e("build-mode-starters.example.simulation.game-of-life.prompt","Build Conway's Game of Life with a paintable grid, play/pause, step, speed control, and pattern presets like glider and gosper gun. Include clear, randomize, and generation counter. Make painting with the mouse fluid and the grid crisp at multiple zoom levels.")},{id:"gravity-sim",label:e("build-mode-starters.example.simulation.gravity-sim.label","Gravity sim"),prompt:e("build-mode-starters.example.simulation.gravity-sim.prompt","Make an orbital gravity simulator where you click-drag to fling planets and watch them orbit, slingshot, and collide. Include mass presets, trail rendering, time scale control, and a clear button. Keep the physics stable enough for satisfying multi-body choreography.")},{id:"fluid-ripples",label:e("build-mode-starters.example.simulation.fluid-ripples.label","Fluid ripples"),prompt:e("build-mode-starters.example.simulation.fluid-ripples.prompt","Build an interactive fluid-ripple simulation that reacts to mouse or touch drags with expanding waves and damping. Include controls for viscosity, wave strength, and color map, plus a clear surface action. Make the effect full-screen and silky on continuous interaction.")}]},{id:"tools",icon:(0,t.jsx)(n.PaintIcon,{size:14}),iconClassName:"text-red-500 dark:text-red-400",iconHoverClassName:"text-fg-tertiary group-hover/chip:text-red-500 dark:group-hover/chip:text-red-400",hoverBorderClassName:"hover:border-red-500/25 dark:hover:border-border-l1",hoverShadowClassName:"dark:hover:shadow-[0_4px_24px_-8px_rgba(239,68,68,0.2)]",examples:[{id:"color-palette",label:e("build-mode-starters.example.tools.color-palette.label","Color palette"),prompt:e("build-mode-starters.example.tools.color-palette.prompt","Build a color-palette generator with five swatches, lock per color, shuffle, and copyable hex, RGB, and HSL values. Include contrast checks against text colors and export of the palette as CSS variables. Make keyboard shortcuts and click-to-copy feel snappy.")},{id:"qr-generator",label:e("build-mode-starters.example.tools.qr-generator.label","QR generator"),prompt:e("build-mode-starters.example.tools.qr-generator.prompt","Create a QR-code generator with a live preview as you type a URL or text, color options for foreground and background, and size control. Include error correction level selection and PNG download. Keep the layout simple with instant feedback and accessible form labels.")},{id:"pixel-art",label:e("build-mode-starters.example.tools.pixel-art.label","Pixel art"),prompt:e("build-mode-starters.example.tools.pixel-art.prompt","Build a pixel-art drawing tool with a resizable grid, color palette, pencil and eraser, fill tool, undo/redo, and PNG export. Include grid toggle, clear canvas, and a limited palette for a retro feel. Make drawing smooth with pointer events and a clean toolbar.")},{id:"photo-booth",label:e("build-mode-starters.example.tools.photo-booth.label","Photo booth"),prompt:e("build-mode-starters.example.tools.photo-booth.prompt","Build a webcam photo booth with live preview, filter presets, a countdown before capture, and snapshot download. Include permission handling, a gallery strip of recent shots, and flip camera when available. Make the UI playful and responsive with clear camera states.")}]},{id:"productivity",icon:(0,t.jsx)(o.ClipboardCheckIcon,{size:14}),iconClassName:"text-blue-500 dark:text-blue-400",iconHoverClassName:"text-fg-tertiary group-hover/chip:text-blue-500 dark:group-hover/chip:text-blue-400",hoverBorderClassName:"hover:border-blue-500/25 dark:hover:border-border-l1",hoverShadowClassName:"dark:hover:shadow-[0_4px_24px_-8px_rgba(96,165,250,0.2)]",examples:[{id:"kanban-board",label:e("build-mode-starters.example.productivity.kanban-board.label","Kanban board"),prompt:e("build-mode-starters.example.productivity.kanban-board.prompt","Build a kanban board with To Do, Doing, and Done columns and draggable cards. Include the ability to add, edit, and delete cards with titles and descriptions, plus card counts per column. Persist board state in local storage and add smooth drag animations.")},{id:"pomodoro-timer",label:e("build-mode-starters.example.productivity.pomodoro-timer.label","Pomodoro timer"),prompt:e("build-mode-starters.example.productivity.pomodoro-timer.prompt","Make a Pomodoro timer with configurable work and break lengths, start/pause/reset, and a task list for the current session. Include session counts, optional sound on complete, and a visual progress ring. Keep the design focused and calm with clear active states.")},{id:"habit-tracker",label:e("build-mode-starters.example.productivity.habit-tracker.label","Habit tracker"),prompt:e("build-mode-starters.example.productivity.habit-tracker.prompt","Build a habit tracker with daily check-offs, a streak calendar, and completion stats for each habit. Include add/edit/delete habits, color coding, and persistence in local storage. Make the weekly or monthly view scannable and motivating.")},{id:"budget-planner",label:e("build-mode-starters.example.productivity.budget-planner.label","Budget planner"),prompt:e("build-mode-starters.example.productivity.budget-planner.prompt","Build a budget planner with income and expense entries, category breakdowns, a savings goal, and a live remaining balance. Include a simple chart of spending by category and the ability to edit or delete transactions. Make numbers easy to scan with a clean finance-app layout.")},{id:"notes-app",label:e("build-mode-starters.example.productivity.notes-app.label","Notes app"),prompt:e("build-mode-starters.example.productivity.notes-app.prompt","Build a notes app with a sidebar list, markdown editing in the main pane, instant search, and create/delete notes. Include last-edited timestamps, local storage persistence, and a preview toggle for rendered markdown. Make keyboard-friendly navigation and a minimal, focused writing UI.")}]},{id:"math",icon:(0,t.jsx)(d.PlusMinusIcon,{size:14}),iconClassName:"text-teal-500 dark:text-teal-400",iconHoverClassName:"text-fg-tertiary group-hover/chip:text-teal-500 dark:group-hover/chip:text-teal-400",hoverBorderClassName:"hover:border-teal-500/25 dark:hover:border-border-l1",hoverShadowClassName:"dark:hover:shadow-[0_4px_24px_-8px_rgba(45,212,191,0.2)]",examples:[{id:"function-grapher",label:e("build-mode-starters.example.math.function-grapher.label","Function grapher"),prompt:e("build-mode-starters.example.math.function-grapher.prompt","Build an interactive function grapher that plots one or more equations with zoom, pan, grid, and a value readout under the cursor. Include example functions, axis labels, and error handling for invalid input. Make the graphing area large and the controls secondary but clear.")},{id:"prime-explorer",label:e("build-mode-starters.example.math.prime-explorer.label","Prime explorer"),prompt:e("build-mode-starters.example.math.prime-explorer.prompt","Build a visual prime-number explorer with an animated sieve of Eratosthenes, clickable integers, and factor breakdowns for composite numbers. Include range controls, play/pause for the animation, and a list of primes found. Make the visualization educational and easy to follow.")},{id:"vector-field",label:e("build-mode-starters.example.math.vector-field.label","Vector field"),prompt:e("build-mode-starters.example.math.vector-field.prompt","Build a vector-field plotter with an editable equation for the field, arrow density controls, and animated flow lines or particles. Include presets, play/pause, and hover readout of vector values. Keep the math UI approachable with immediate visual feedback.")},{id:"probability-lab",label:e("build-mode-starters.example.math.probability-lab.label","Probability lab"),prompt:e("build-mode-starters.example.math.probability-lab.prompt","Create a probability simulator with dice and coin modes, configurable trial counts, and a live histogram of outcomes that updates as trials run. Include theoretical probability comparison, reset, and speed control for animations. Make it useful for teaching basic probability intuition.")},{id:"fourier-drawing",label:e("build-mode-starters.example.math.fourier-drawing.label","Fourier drawing"),prompt:e("build-mode-starters.example.math.fourier-drawing.prompt","Build a Fourier-series toy that redraws a drawn or preset shape with spinning epicycles, adjustable term count, and playback speed. Include draw-your-own mode, play/pause, and a trail of the reconstructed path. Make the epicycles visually clear and the controls simple.")}]}],b[0]=g,b[1]=h):h=b[1],h}])},2255587,e=>{"use str